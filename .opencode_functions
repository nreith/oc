#!/usr/bin/env bash

# OpenCode Bash Functions

# Usage:
#   ocp list              -> Show all plugins
#   ocp enable <name>     -> Explicitly enable
#   ocp disable <name>    -> Explicitly disable
#   ocp remove <name>     -> Delete the line
#   ocp <name>            -> Toggle (classic behavior)
ocp() {
    local cmd=$1
    local plugin=$2
    local file="$HOME/.config/opencode/opencode.json"

    [[ ! -f "$file" ]] && echo "❌ Config not found" && return 1

    # --- 1. PRE-FLIGHT: Auto-expand single-line list ---
    if grep -q '^[[:space:]]*"plugin":[[:space:]]*\[.*\]' "$file"; then
        sed -i 's/"plugin":[[:space:]]*\[/"plugin": \[\n    /g' "$file"
        sed -i '/"plugin": \[/,/\]/ s/, /,\n    /g' "$file"
        sed -i '/"plugin": \[/,/\]/ s/ \]/ \n  \]/g' "$file"
    fi

    # --- 2. LIST COMMAND ---
    if [[ "$cmd" == "list" ]]; then
        echo "🔌 OpenCode Plugins:"
        sed -n '/"plugin": \[/,/\]/p' "$file" | grep '"' | grep -v '"plugin":' | while read -r line; do
            local name=$(echo "$line" | sed -E 's/^[[:space:]]*(\/\/ )?"([^"]+)".*/\2/')
            if [[ "$line" =~ ^[[:space:]]*// ]]; then
                echo "  ⚪ $name (disabled)"
            else
                echo "  🟢 $name"
            fi
        done
        return 0
    fi

    # --- 3. HANDLE ARGUMENTS ---
    # If first arg is enable/disable/remove, use $2 as plugin. Otherwise, toggle $1.
    local action="toggle"
    if [[ "$cmd" == "enable" || "$cmd" == "disable" || "$cmd" == "remove" ]]; then
        action=$cmd
    else
        plugin=$cmd
    fi

    [[ -z "$plugin" ]] && echo "Usage: ocp [list | enable | disable | remove | <name>]" && return 1

    # --- 4. EXECUTE ACTIONS ---
    case "$action" in
        remove)
            sed -i "/\"$plugin\"/d" "$file"
            echo "🗑️  Removed $plugin"
            ;;
        enable)
            if grep -q "^[[:space:]]*//.*\"$plugin\"" "$file"; then
                sed -i "s|^\([[:space:]]*\)//[[:space:]]*\(\"$plugin\".*\)|\1\2|" "$file"
                echo "🟢 Enabled $plugin"
            elif grep -q "\"$plugin\"" "$file"; then
                echo "ℹ️  $plugin is already enabled"
            else
                sed -i "/\"plugin\": \[/a \    \"$plugin\"," "$file"
                echo "✨ Added and enabled $plugin"
            fi
            ;;
        disable)
            if grep -q "\"$plugin\"" "$file" && ! grep -q "^[[:space:]]*//.*\"$plugin\"" "$file"; then
                sed -i "s|^\([[:space:]]*\)\(\"$plugin\".*\)|\1// \2|" "$file"
                echo "🔴 Disabled $plugin"
            else
                echo "ℹ️  $plugin is already disabled or not found"
            fi
            ;;
        toggle)
            if grep -q "\"$plugin\"" "$file" && ! grep -q "^[[:space:]]*//.*\"$plugin\"" "$file"; then
                ocp disable "$plugin"
            else
                ocp enable "$plugin"
            fi
            ;;
    esac
}

oc() {
    ocp disable oh-my-opencode@latest && opencode
}

omo() {
    ocp enable oh-my-opencode@latest
    local base_name=$(basename "$PWD")
    local path_hash=$(echo "$PWD" | md5sum | cut -c1-4)
    local session_name="${base_name}-${path_hash}"

    # Find available port
    local port=4096
    while [ $port -lt 5096 ]; do
        if ! lsof -i :$port >/dev/null 2>&1; then
            break
        fi
        port=$((port + 1))
    done

    export OPENCODE_PORT=$port

    if [ -n "$TMUX" ]; then
        opencode --port $port "$@"
    else
        local oc_cmd="OPENCODE_PORT=$port opencode --port $port $*; exec $SHELL"
        if tmux has-session -t "$session_name" 2>/dev/null; then
            tmux new-window -t "$session_name" -c "$PWD" "$oc_cmd"
            tmux attach-session -t "$session_name"
        else
            tmux new-session -s "$session_name" -c "$PWD" "$oc_cmd"
        fi
    fi
}