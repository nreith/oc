# OpenCode Bash Functions

oc_plugin() {
    local action=$1
    local plugin=$2
    local file="/home/nick/.config/opencode/opencode.json"

    [[ ! -f "$file" ]] && echo "Error: Config not found at $file" && return 1

    # Ensure jq is available for reliable JSON manipulation
    if ! command -v jq > /dev/null; then
        echo "Error: jq is required for oc_plugin but not installed."
        return 1
    fi

    case "$action" in
        add)
            # Add the plugin if it's not already present
            if jq -e --arg p "$plugin" '.plugin // [] | index($p)' "$file" > /dev/null; then
                echo "Plugin '$plugin' is already enabled."
                return 0
            fi
            jq --arg p "$plugin" '.plugin = ( (.plugin // []) + [$p] | unique )' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
            echo "Enabled $plugin"
            ;;
        remove)
            # Remove the plugin if it exists
            if ! jq -e --arg p "$plugin" '.plugin // [] | index($p)' "$file" > /dev/null; then
                echo "Plugin '$plugin' is not enabled."
                return 0
            fi
            jq --arg p "$plugin" '.plugin = ( (.plugin // []) - [$p] )' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
            echo "Disabled $plugin"
            ;;
        *)
            echo "Usage: oc_plugin [add|remove] [plugin-name]"
            return 1
            ;;
    esac
}


oc() {
    oc_plugin remove oh-my-opencode
    opencode
}

omo() {
    oc_plugin add oh-my-opencode
    local base_name=$(basename "$PWD")
    local path_hash=$(echo "$PWD" | md5sum | cut -c1-4)
    local session_name="${base_name}-${path_hash}"

    # Find available port
    local port=4096
    while [ $port -lt 5096 ]; do
        if ! lsof -i :$port >/dev/null 2>&1; then
            break
        fi
        port=$((port + 1))
    done

    export OPENCODE_PORT=$port

    if [ -n "$TMUX" ]; then
        opencode --port $port "$@"
    else
        local oc_cmd="OPENCODE_PORT=$port opencode --port $port $*; exec $SHELL"
        if tmux has-session -t "$session_name" 2>/dev/null; then
            tmux new-window -t "$session_name" -c "$PWD" "$oc_cmd"
            tmux attach-session -t "$session_name"
        else
            tmux new-session -s "$session_name" -c "$PWD" "$oc_cmd"
        fi
    fi
}