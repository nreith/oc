{
  "$schema": "https://opencode.ai/config.json",
  // ========================================================================
  //   OPENCODE CONFIGURATION
  //   Docs:     https://opencode.ai/docs/config
  //   OmO:      https://github.com/opencode-ai/oh-my-opencode
  //   Zen:      https://opencode.ai/docs/zen
  // ========================================================================

  // Always read these files for context if they exist
  // "instructions": ["README.md", "CONVENTIONS.md", "AGENTS.md"],
  "autoupdate": false,
  "theme": "rosepine",
  "share": "disabled",
  "permission": { }, // All are allowed by default: https://opencode.ai/docs/tools/
  "model": "custom/gpt-oss-120b",
  "small_model": "custom/llama-3-2-3b-instruct",
  "enabled_providers": [ "custom" ],
  "plugin": [
    "superpowers@latest",
    "oh-my-opencode@latest",
     
  ],
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "custom",
      "options": {
        // I'm using the env var versions here, and not the local gateway.
        //  if using local-llm-proxy, switch to the ones below
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
        // The settings below are for if you are using my local-llm-proxy
        // Only necessary if you need Oauth2 or SSO with token refresh
        // "baseURL": "http://localhost:8000",
        // "apiKey": "sk-dummy"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "oss-120b",
          "limit": {
            // "context": 131072,
            "context": 114688,
            "output": 16384
          },
          "reasoning": true,
          "tool_call": true,
          "tools": true
        },
        "llama-3-3-70b-instruct": {
          "name": "llama-70b",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "reasoning": true,
          "tool_call": true,
          "tools": true
        },
        "mistral-small-3-1-24b-instruct-2503": {
          "name": "mistral-small-24b",
          "limit": {
            "context": 114688,
            "output": 8192
          }
        },
        "codestral-22b-v0-1": {
          "name": "codestral-22b",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "gemma-3-27b-it": {
          "name": "gemma-3-27b",
          "limit": {
            "context": 114688,
            "output": 8192
          }
        },
        "gpt-oss-20b": {
          "name": "oss-20b",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "pixtral-12b-2409": {
          "name": "pixtral-12b",
          "limit": {
            "context": 114688,
            "output": 8192
          }
        },
        "llama-3-2-3b-instruct": {
          "name": "llama-3b",
          "limit": {
            "context": 114688,
            "output": 4096
          }
        }
        // Why these models were chosen (and others excluded):
        //   Mistral Small & Codestral: These are elite coding models for their size. 
        //      Mistral Small (24B) is particularly good at following complex system instructions in opencode.
        //   Gemma 3 (27B): This is Google's latest state-of-the-art weights; 
        //      it excels at reasoning and logical derivations needed for MLOps pipelines.
        //   Pixtral 12B: Included because it can handle multi-modal inputs 
        //      (like screenshots of UI bugs or architecture diagrams) while remaining very capable at coding.
        //   Excluded:
        //       CodeLlama 13B: This is now significantly outperformed by Llama 3.2 3B 
        //            and Mistral variants in terms of logic and context window.
        //       Llama Guard: This is a safety/moderation model, not a coding assistant.
        //       Gemma 3 270M: At 270 million parameters, it lacks the "brainpower" 
        //            for the agentic tool-calling required by OpenCode.
      }
  }
  },

  // --- MCP Servers (Strict Format) ---
  "mcp": {
    // 1. Brave Search (Web Search)
    "brave": {
      "type": "local",
      "command": [ "npx", "-y", "@modelcontextprotocol/server-brave-search" ],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    }
  },
  // --- Custom Commands (Optional) ---
  "command": {
    "test": {
      "description": "Run project tests and auto-fix",
      "template": "Run the full test suite and fix any errors."
    }
  },
  // --- IGNORE PATTERNS ---
  // Critical for performance. Keep the agent out of these folders.
  "watcher": {
    "ignore": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.venv/**",
        "**/__pycache__/**",
        "**/.opencode_history",
        "**/.opencode_storage",
        "**/dist/**",
        "uv.lock",
        "package-lock.json"
    ]
  }
}
