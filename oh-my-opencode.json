{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "custom/gpt-oss-120b",
      "reasoning": true,
      "tool_call": true,
      "variant": "high",
      "maxTokens": 16384,
      "stream": false
    },
    "oracle": {
      "model": "custom/gpt-oss-120b",
      "reasoning": true,
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
      "stream": false
    },
    "librarian": {
      "model": "custom/mistral-small-3-1-24b-instruct-2503",
      "context": 128000,
      "tool_call": true,
      "stream": false
    },
    "executor": {
      "model": "custom/llama-3-3-70b-instruct",
      "tool_call": true,
      "reasoning": true,
      "permission": {
        "bash": "allow"
      },
      "stream": false
    },
    "explore": {
      "model": "custom/llama-3-3-70b-instruct",
      "tool_call": true,
      "stream": false
    },
    "frontend_engineer": {
      "model": "custom/pixtral-12b-2409",
      "context": 128000,
      "tool_call": true,
      "stream": false
    },
    "hephaestus": {
      "model": "custom/codestral-22b-v0-1"
    },
    "multimodal-looker": {
      "model": "custom/pixtral-12b-2409"
    },
    "prometheus": {
      "model": "custom/gpt-oss-120b"
    },
    "metis": {
      "model": "custom/mistral-small-3-1-24b-instruct-2503"
    },
    "momus": {
      "model": "custom/gpt-oss-20b"
    },
    "atlas": {
      "model": "custom/llama-3-3-70b-instruct"
    }
  },
  "categories": {
    "quick": {
      "model": "custom/gpt-oss-20b",
      "stream": false
    },
    "visual-engineering": {
      "model": "custom/pixtral-12b-2409",
      "stream": false
    },
    "logic": {
      "model": "custom/gpt-oss-120b",
      "variant": "high",
      "stream": false
    },
    "ultrabrain": {
      "model": "custom/gpt-oss-120b"
    },
    "deep": {
      "model": "custom/gpt-oss-120b"
    },
    "artistry": {
      "model": "custom/mistral-small-3-1-24b-instruct-2503"
    },
    "unspecified-low": {
      "model": "custom/llama-3-2-3b-instruct"
    },
    "unspecified-high": {
      "model": "custom/llama-3-3-70b-instruct"
    },
    "writing": {
      "model": "custom/mistral-small-3-1-24b-instruct-2503"
    }
  },
  "browser_automation_engine": "custom/pixtral-12b-2409",
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}
